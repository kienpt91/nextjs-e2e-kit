{
  "name": "nextjs-e2e-kit",
  "version": "0.1.0",
  "description": "A small, reusable Playwright end-to-end kit for a Next.js site with a database-backed CMS: link crawler, ARIA tab and dialog checks, scroll-aware header, mobile layout, reduced motion, negative controls, and GitLab CI and GitHub Actions definitions with a Postgres service.",
  "keywords": [
    "playwright",
    "e2e",
    "nextjs",
    "gitlab-ci",
    "github-actions",
    "accessibility",
    "postgres"
  ],
  "license": "MIT",
  "author": "Kien Phan",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "db:wait": "node src/db/cli.ts wait",
    "db:migrate": "node src/db/cli.ts migrate",
    "db:seed": "node src/db/cli.ts seed",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "coverage": "node scripts/coverage.ts",
    "test:e2e": "playwright test",
    "negative-controls": "node scripts/negative-controls.ts",
    "lint:ci": "node scripts/lint-ci.ts",
    "check:deps-age": "node scripts/check-dep-age.mjs"
  },
  "dependencies": {
    "next": "16.4.3",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ajv": "8.20.0",
    "typescript": "6.0.3",
    "yaml": "2.9.1"
  }
}
