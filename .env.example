# Placeholders only. Real values come from your secret store, never from this repository.
# The password goes in PGPASSWORD (or a .pgpass file), not in the URL.
DATABASE_URL=postgres://site@db.internal:5432/site
PGPASSWORD=
# optional: where the Playwright suite looks for the site (default http://127.0.0.1:3000)
E2E_BASE_URL=http://127.0.0.1:3000
# optional, DEMO SITE ONLY: break one behaviour on purpose for the negative controls (see docs/negative-controls.md).
# Never set this in a real deployment. Empty means no fault.
DEMO_FAULT=
